<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.local.micguard</string>
    <key>ProgramArguments</key>
    <array><string>/Users/YOUR_USERNAME/tools/micguard</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/Users/YOUR_USERNAME/Library/Logs/micguard.log</string>
    <key>StandardErrorPath</key><string>/Users/YOUR_USERNAME/Library/Logs/micguard.log</string>
</dict>
</plist>
